+/** Read the real filtered rows for native accessibility; selection still uses original input. */
+void VisitNetworkContentRows(const std::function<void(const Rect &, const Rect &, std::string_view, int, bool)> &visitor)
+{
+	for (Window *base : Window::IterateFromFront()) {
+		auto *w = dynamic_cast<NetworkContentListWindow *>(base);
+		if (w == nullptr) continue;
+		auto *matrix = w->GetWidget<NWidgetBase>(WID_NCL_MATRIX);
+		Rect row = matrix->GetCurrentRect().WithHeight(matrix->resize_y).Translate(w->left, w->top);
+		Rect checkbox = w->GetWidget<NWidgetBase>(WID_NCL_CHECKBOX)->GetCurrentRect().Translate(w->left, w->top);
+		auto [first, last] = w->vscroll->GetVisibleRangeIterators(w->content);
+		int index = w->vscroll->GetPosition();
+		for (auto it = first; it != last; ++it, ++index) {
+			const ContentInfo *item = *it;
+			std::string label = item->name + " " + item->version;
+			bool disabled = item->state == ContentInfo::State::AlreadyHere || item->state == ContentInfo::State::DoesNotExist;
+			if (FindWindowFromPt((row.left + row.right) / 2, (row.top + row.bottom) / 2) == w) visitor(row, checkbox.WithY(row), label, index, disabled);
+			row = row.Translate(0, matrix->resize_y);
+		}
+	}
+}
