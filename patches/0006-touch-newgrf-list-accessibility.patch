+
+/** Read original active/available NewGRF rows for native accessibility. */
+void VisitNewGRFRows(const std::function<void(const Rect &, std::string_view, int, bool)> &visitor)
+{
+	for (Window *base : Window::IterateFromFront()) {
+		auto *w = dynamic_cast<NewGRFWindow *>(base);
+		if (w == nullptr) continue;
+		for (bool active : {false, true}) {
+			auto *widget = w->GetWidget<NWidgetBase>(active ? WID_NS_FILE_LIST : WID_NS_AVAIL_LIST);
+			Rect row = widget->GetCurrentRect().Shrink(WidgetDimensions::scaled.framerect).WithHeight(widget->resize_y).Translate(w->left, w->top);
+			Scrollbar *scroll = active ? w->vscroll : w->vscroll2;
+			int index = 0;
+			auto visit = [&](const GRFConfig *item) {
+				if (scroll->IsVisible(index)) {
+					if (FindWindowFromPt((row.left + row.right) / 2, (row.top + row.bottom) / 2) == w) visitor(row, item->GetName(), index, active);
+					row = row.Translate(0, widget->resize_y);
+				}
+				++index;
+			};
+			if (active) { for (const auto &item : w->actives) visit(item.get()); }
+			else { for (const auto *item : w->avails) visit(item); }
+		}
+	}
+}
+
+#ifdef OTTD_TOUCH_UI
+/** Reuse the original scan callback so the existing available list rebuilds. */
+bool RefreshNativeNewGRFs()
+{
+	auto *window = dynamic_cast<NewGRFWindow *>(FindWindowById(WC_GAME_OPTIONS, WN_GAME_OPTIONS_NEWGRF_STATE));
+	return RequestNewGRFScan(window);
+}
+#endif
