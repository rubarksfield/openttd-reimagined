+/** Visit visible rows on the engine owner, preserving original text and hit geometry. */
+void VisitDropDownListRows(const std::function<void(const Rect &, std::string_view, int, bool)> &visitor)
+{
+	auto *w = dynamic_cast<DropdownWindow *>(FindWindowByClass(WC_DROPDOWN_MENU));
+	if (w == nullptr) return;
+	auto *panel = w->GetWidget<NWidgetBase>(WID_DM_ITEMS);
+	int left = w->left + panel->pos_x + WidgetDimensions::scaled.dropdownlist.left;
+	int top = w->top + panel->pos_y + WidgetDimensions::scaled.dropdownlist.top;
+	int right = w->left + panel->pos_x + panel->current_x - WidgetDimensions::scaled.dropdownlist.right - 1;
+	int bottom = w->top + panel->pos_y + panel->current_y - WidgetDimensions::scaled.dropdownlist.bottom - 1;
+	int y = top - w->vscroll->GetPosition();
+	for (const auto &item : w->list) {
+		int height = DropDownItemHeight(*item);
+		auto *text = dynamic_cast<const DropDownListStringItem *>(item.get());
+		if (text != nullptr && item->Selectable() && y >= top && y + height - 1 <= bottom) {
+			visitor({left, y, right, y + height - 1}, text->GetAccessibleLabel(), item->result, item->masked);
+		}
+		y += height;
+	}
+}
