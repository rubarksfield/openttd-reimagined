+/** Presentation-only sizing for a native touch host. */
+static uint DropDownItemHeight(const DropDownListItem &item)
+{
+#ifdef OTTD_TOUCH_UI
+	extern uint _openttd_touch_target;
+	if (item.Selectable()) return std::max(item.Height(), _openttd_touch_target);
+#endif
+	return item.Height();
+}
 
