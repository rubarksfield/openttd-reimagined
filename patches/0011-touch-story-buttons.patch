+#ifdef OTTD_TOUCH_UI
+	/** Read the original rendered button layout; do not synthesize actions. */
+	void VisitTouchButtons(const std::function<void(const Rect &, std::string_view, uint32_t)> &visitor) const
+	{
+		this->EnsureStoryPageElementLayout();
+		const Rect clip = this->GetWidget<NWidgetBase>(WID_SB_PAGE_PANEL)->GetCurrentRect().Shrink(WidgetDimensions::scaled.frametext).Translate(this->left, this->top);
+		for (const auto &ce : this->layout_cache) {
+			if (ce.pe->type != SPET_LOCATION && ce.pe->type != SPET_BUTTON_PUSH && ce.pe->type != SPET_BUTTON_TILE && ce.pe->type != SPET_BUTTON_VEHICLE) continue;
+			Rect rect = ce.bounds.Translate(clip.left, clip.top - this->vscroll->GetPosition());
+			--rect.bottom; --rect.right;
+			if (rect.left < clip.left || rect.top < clip.top || rect.right > clip.right || rect.bottom > clip.bottom) continue;
+			if (FindWindowFromPt((rect.left + rect.right) / 2, (rect.top + rect.bottom) / 2) != this) continue;
+			visitor(rect, ce.pe->text.GetDecodedString(), ce.pe->index.base());
+		}
+	}
+#endif
